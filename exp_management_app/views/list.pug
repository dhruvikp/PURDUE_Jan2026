extends layout

block content
  .card
    h1 Expense List

    table.table
      tr
        th Title
        th Amount
        th Receipt
        th Action

      each exp in expenses
        tr
          td #{exp.title}
          td ₹#{exp.amount}
          td 
            if exp.file
              span #{exp.file}
            else
              span No file
          td
            a.delete-btn(href=`/delete/${exp.id}` data-cy="delete") Delete |
            a(href=`/edit/${exp.id}` data-cy="edit") Edit 

    br
    a(href="/" data-cy="add-expense") Add New Expense |
    a(href="/logout" data-cy="logout") Logout